---
import BaseLayout from './baseLayout.astro';
import { calculateReadingTime } from '../utils/reading-time';
import { getNoteNavigation } from '../utils/getNoteNavigation';

const { frontmatter } = Astro.props;
if (frontmatter.draft == true && import.meta.env.PROD) {
  return Astro.redirect('/notes', 302);
}

const slug = Astro.url.pathname.split('/').filter(Boolean).pop();
const date = new Date(frontmatter.pubDate).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const rawPosts = import.meta.glob<string>('../pages/notes/*.mdx', {
  eager: true,
  query: '?raw',
  import: 'default',
});
const markdown =
  Object.entries(rawPosts).find(([path]) =>
    path.endsWith(`/${slug}.mdx`)
  )?.[1] ?? '';
const readTime = calculateReadingTime(markdown);
const tags = frontmatter.tags ?? [];

const notes = getNoteNavigation();

const normalisePath = (path: string): string => {
  return path.replace(/\/$/, '');
};

const currentPath = normalisePath(Astro.url.pathname);

const currentIndex = notes.findIndex(note => {
  return normalisePath(note.url) === currentPath;
});

const newerNote = currentIndex > 0 ? notes[currentIndex - 1] : undefined;

const olderNote =
  currentIndex >= 0 && currentIndex < notes.length - 1
    ? notes[currentIndex + 1]
    : undefined;
---

<BaseLayout
  title={`${frontmatter.title} — VAM Digital Studio`}
  description={frontmatter.description}
>
  <article class="article-page">
    <header class="article-hero grid-frame">
      <div class="article-hero__rail">
        <a href="/notes" class="article-back" data-note-back>← Back to notes</a>
        <div class="article-rail__meta">
          <span class="eyebrow">{frontmatter.category ?? 'Note'}</span>
          <dl>
            <div><dt>Published</dt><dd>{date}</dd></div>
            <div><dt>Reading time</dt><dd>{readTime}</dd></div>
          </dl>
        </div>
      </div>

      <div class="article-hero__content">
        <p class="eyebrow">
          Field note · {String(tags.length).padStart(2, '0')} topics
        </p>
        <h1 transition:name={`post-title-${slug}`}>{frontmatter.title}</h1>
        <p class="article-deck">{frontmatter.description}</p>
      </div>
    </header>

    <div class="article-body grid-frame">
      <aside class="article-sidebar">
        <div class="article-sidebar__inner">
          <div class="article-sidebar__section">
            <p>Topics</p>
            <div class="post-tags">
              {tags.map(tag => <span class="post-tag">{tag}</span>)}
            </div>
          </div>
          <p class="article-sidebar__note">
            Practical notes from designing, modernising, and testing frontend
            products.
          </p>
        </div>
      </aside>

      <div class="article-content">
        <slot />
      </div>
    </div>

    <section class="note-end">
      <!-- <header class="note-end__header"> -->
      <!--   <div> -->
      <!--     <p class="note-end__eyebrow">Continue reading</p> -->
      <!--     <h2 class="note-end__heading"> -->
      <!--       More notes on building thoughtful interfaces. -->
      <!--     </h2> -->
      <!--   </div> -->
      <!---->
      <!--   <a href="/notes" class="note-end__all"> View all notes </a> -->
      <!-- </header> -->

      <nav class="note-neighbours" aria-label="More notes">
        {
          newerNote && (
            <a href={newerNote.url} class="note-neighbour">
              <span class="note-neighbour__direction">
                <span
                  class="note-neighbour__arrow note-neighbour__arrow--left"
                  aria-hidden="true"
                />
                Newer note
              </span>

              <span class="note-neighbour__title">{newerNote.title}</span>
            </a>
          )
        }

        {
          olderNote && (
            <a href={olderNote.url} class="note-neighbour">
              <span class="note-neighbour__direction">
                Older note
                <span
                  class="note-neighbour__arrow note-neighbour__arrow--right"
                  aria-hidden="true"
                />
              </span>

              <span class="note-neighbour__title">{olderNote.title}</span>
            </a>
          )
        }
      </nav>
    </section>
    <footer class="article-footer grid-frame">
      <div>
        <span class="eyebrow">Continue exploring</span><p>
          More notes on engineering thoughtful interfaces.
        </p>
      </div>
      <a href="/notes" class="button button-secondary" data-note-back
        >All notes <span aria-hidden="true">→</span></a
      >
    </footer>
  </article>
</BaseLayout>
