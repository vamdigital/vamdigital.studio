---
import BaseLayout from '../layouts/baseLayout.astro';
import Title from '../components/title.astro';

const strengths = [
  { number: '01', title: 'Product engineering', copy: 'I turn ambiguous product needs into clear, reliable interfaces—from discovery and architecture through testing and delivery.' },
  { number: '02', title: 'Frontend architecture', copy: 'Scalable React structures, TypeScript migrations, build tooling, automated quality, and maintainable system boundaries.' },
  { number: '03', title: 'Design collaboration', copy: 'A UI/UX background and close design partnership, with strong attention to interaction, accessibility, and visual detail.' }
];
---

<BaseLayout title="About me — VAM Digital Studio" description="About Vaibhav Shringarpure, a senior frontend engineer working across design and engineering.">
  <Title mainTitle="About me" subTitle="Working at the intersection of design, engineering, and writing." />

  <section class="about-grid grid-frame">
    <div class="about-statement">
      <p class="eyebrow">My approach</p>
      <h2>From legacy code to a frontend teams want to build on.</h2>
      <p>I’m a senior frontend engineer with a background in UI/UX design. I’m most useful where a product is established, the problem is complex, and the team needs someone who can bring clarity without demanding a full rewrite.</p>
      <p>I work comfortably across product, design, backend, QA, and security while remaining hands-on in delivery.</p>
      <div class="profile-line">
        <div class="profile-photo">
          <img src="/vaibhav-profile.jpg" alt="Vaibhav Shringarpure" width="72" height="72" />
        </div>
        <span><strong>Vaibhav Shringarpure</strong><small>Senior Frontend Engineer · London, UK</small></span>
      </div>
    </div>
    <div class="strength-list">
      {strengths.map(strength => (
        <article class="strength-row"><span class="path-number">{strength.number}</span><div><h3>{strength.title}</h3><p>{strength.copy}</p></div></article>
      ))}
    </div>
  </section>

  <section class="about-note grid-frame">
    <p class="text-xxl text-italic line-height-sm">Clarity is not the absence of complexity. It is the result of working through it carefully.</p>
    <div><p class="eyebrow">Currently</p><p>Modernising enterprise frontend experiences at Nasuni—bringing clarity to complex product workflows through React, TypeScript, testing, and close design collaboration.</p></div>
  </section>
</BaseLayout>
